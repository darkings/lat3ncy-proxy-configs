# Rendered by deploy/stash-updater/render-config.sh. Do not edit on the server.
# This file is the single source of remote configuration: the systemd timer
# loads it through EnvironmentFile, and the manual deploy passes the same
# values on the ssh command line. It contains no credentials.
STASH_REMOTE_ROOT=@@REMOTE_ROOT@@
STASH_UPDATER_ROOT=@@UPDATER_ROOT@@
KELEE_PUBLIC_BASE=@@PUBLIC_BASE@@
KELEE_MIRROR_BASE=@@MIRROR_BASE@@
STASH_PUBLIC_HOST=@@PUBLIC_HOST@@
STASH_HTTP_HOST=127.0.0.1
STASH_HTTP_PORT=@@HTTP_PORT@@
STASH_CONTAINER_NAME=@@CONTAINER_NAME@@
STASH_KEEP_RELEASES=@@KEEP_RELEASES@@
STASH_KEEP_ASSET_DAYS=@@KEEP_ASSET_DAYS@@
STASH_CADDY_SITE_ROOT=@@CADDY_SITE_ROOT@@
