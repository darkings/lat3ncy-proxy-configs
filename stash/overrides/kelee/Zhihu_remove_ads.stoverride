# 知乎去广告
# 移除HTTPDNS和QUIC传输配置，移除开屏广告、信息流广告、回答页广告，移除回答页下的相关回答、专栏卡片及圈子卡片，移除直答页面推荐知识库和提问推荐，移除评论区评论氛围满意度调查，精简首页顶部标签及我的页面。
# author: 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# homepage: https://hub.kelee.one
# icon: https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Zhihu.png
# date: 2026-06-01 17:11:35
# lpx: https://kelee.one/Tool/Loon/Lpx/Zhihu_remove_ads.lpx
# converted: Loon .lpx -> Stash .stoverride (auto) v2
# note: kelee.one resources require Loon UA; if Stash fetch fails, add proxy or use GitHub mirror
name: 知乎去广告
desc: 移除HTTPDNS和QUIC传输配置，移除开屏广告、信息流广告、回答页广告，移除回答页下的相关回答、专栏卡片及圈子卡片，移除直答页面推荐知识库和提问推荐，移除评论区评论氛围满意度调查，精简首页顶部标签及我的页面。
icon: https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Zhihu.png
http:
  mitm:
  - m-cloud.zhihu.com
  - api.zhihu.com
  - www.zhihu.com
  - page-info.zhihu.com
  - zhida.zhihu.com
  url-rewrite:
  - ^https:\/\/api\.zhihu\.com\/commercial_api\/ - reject-dict
  - ^https:\/\/api\.zhihu\.com\/next-render\?id=\d+&type=answer - reject-dict
  - ^https:\/\/api\.zhihu\.com\/search\/preset_words\? - reject-dict
  - ^https:\/\/api\.zhihu\.com\/search\/related_queries\/question\/\d+$ - reject-dict
  - ^https:\/\/zhida\.zhihu\.com\/ai_ingress\/knowledge\/square\/categories\/feeds\?categoryId=1%7D$ - reject-dict
  - ^https:\/\/zhida\.zhihu\.com\/ai_ingress\/ai_chat\/guidance$ - reject-dict
  - ^https:\/\/api\.zhihu\.com\/content-distribution-core\/bubble\/common\/show$ - reject-dict
  - ^https:\/\/www\.zhihu\.com\/api\/v\d\/members\/homepage_card$ - reject-dict
  - ^https:\/\/api\.zhihu\.com\/people\/homepage_entry_v\d$ - reject-dict
  - ^https:\/\/api\.zhihu\.com\/kvip\/right\/my_card\? - reject-dict
  - ^https:\/\/api\.zhihu\.com\/unlimited\/go\/my_card\/v\d\? - reject-dict
  body-rewrite:
  - '^https:\/\/m-cloud\.zhihu\.com\/api\/cloud\/zhihu\/config\/all\? response-jq def drop_keys: {"km_httpdns_new_config_tars":true,"preFetchHttpDns":true,"httpdns_detector_use_concurrent":true,"httpdns_use_memory_cache":true,"httpdns_new_config_tars":true,"coreNetworkConf_useTars":true,"km_coreNetworkConf_useTars":true,"sugarQuicConfig":true,"quic_dns_detect_enable":true,"quicMixAB":true,"quic_downgrade_enable":true,"quic_priority_strategy":true,"quic_check_health_enable":true,"tquic_configuration":true,"networkExprimentList":true,"tars_ab_list":true,"zaSetExtraRequestHeader":true}; .data.configs |= map(select((drop_keys[.configKey] // false) | not) | if (.configValue | type) == "object" then del(.configValue.delayHttpdns, .configValue.dnsParser, .configValue.HTTPDNS) else . end)'
  - '^https:\/\/api\.zhihu\.com\/root\/tab\/v\d(?:\?.+)?$ response-jq .tab_list |= map(select(.tab_type == "follow" or .tab_type == "recommend" or .tab_type == "hot" or .tab_type == "ring_tab"))'
  - '^https:\/\/api\.zhihu\.com\/topstory\/recommend\? response-jq .data |= map(select(.type == "ComponentCard"))'
  - '^https:\/\/api\.zhihu\.com\/questions\/\d+\/feeds\? response-json-del ad_info'
  - '^https:\/\/api\.zhihu\.com\/comment_v\d\/(answers|pins)\/\d+\/root_comment\? response-json-del atmosphere_voting_config'
  - '^https:\/\/(api|page-info)(?:\.zhihu)?\.com\/answers\/v\d\/\d+(?:\?.*)?$ response-json-del third_business float_search_word'
  - '^https:\/\/(api|page-info)(?:\.zhihu)?\.com\/answers\/v\d\/\d+(?:\?.*)?$ response-jq .structured_content.segments |= map(select(.type != "card"))'
  - '^https:\/\/api\.zhihu\.com\/topstory\/recommend\? response-jq .data[]?.children |= (if type == "array" then map(select(.id != "ring")) else . end)'
  - '^https:\/\/api\.zhihu\.com\/(articles|answers|pins)\/v\d\/\d+\? response-json-del third_business ring_info interaction_bar_plugins'
  - '^https:\/\/api\.zhihu\.com\/comment_v\d\/answers\/\d+\/list-headers$ response-json-del continuous_consumption_module'
  - '^https:\/\/api\.zhihu\.com\/podcasts\/hub\/v\d$ response-json-del banners'
  - '^https:\/\/api\.zhihu\.com\/search\/recommend_query\/v\d\? response-jq .recommend_queries.queries |= map(select(.type == "normal"))'
  - '^https:\/\/api\.zhihu\.com\/search_v\d\? response-json-del pendant'
  - '^https:\/\/api\.zhihu\.com\/search\/tabs\? response-jq .data |= map(select(.t | IN("general", "ai_zhida", "recent", "people", "zvideo", "ring", "topic", "podcast", "column", "pin", "favlist")))'
  - '^https:\/\/api\.zhihu\.com\/people\/self$ response-json-del vip_info.entrance_new.right_button vip_info.entrance_v2'
