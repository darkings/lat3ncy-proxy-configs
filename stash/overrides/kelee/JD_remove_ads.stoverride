# 京东去广告
# 移除京东开屏广告，精简我的页面产品推广。
# author: RuCu6[https://github.com/RuCu6], Maasea[https://github.com/Maasea]
# homepage: https://hub.kelee.one
# icon: https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/JD.png
# date: 2026-06-01 17:11:35
# lpx: https://kelee.one/Tool/Loon/Lpx/JD_remove_ads.lpx
# converted: Loon .lpx -> Stash .stoverride (auto) v2
# note: kelee.one resources require Loon UA; if Stash fetch fails, add proxy or use GitHub mirror
name: 京东去广告
desc: 移除京东开屏广告，精简我的页面产品推广。
icon: https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/JD.png
rules:
- URL-REGEX,"^http:\/\/\w{32}\.jddebug\.com\/diagnose\?",REJECT
script-providers:
  jd-remove-ads:
    url: https://cdn.jsdelivr.net/gh/RuCu6/QuanX@main/Scripts/jingdong.js
    interval: 86400
http:
  mitm:
  - api.m.jd.com
  url-rewrite:
  - ^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(searchBoxWord|stationPullService|uniformRecommend[06]) - reject-dict
  body-rewrite:
  - ^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=basicConfig response-jq ".data.JDMessage.socketmonitor.isSocketEstablishedAhead = 0 | .data.JDMessage.socketmonitor.isSocketReport = 0 | .data.JDHttpToolKit.httpdns.httpdns = 0"
  script:
  - match: ^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(deliverLayer|getTabHomeInfo|myOrderInfo|orderTrackBusiness|personinfoBusiness|start|welcomeHome)
    name: jd-remove-ads
    type: response
    require-body: true
