# Spotify去广告
# 移除播放广告，恢复歌手和专辑列表的正常展示。修改插件自定义配置项需要重新登陆方可生效。
# author: 001ProMax[https://github.com/001ProMax]
# homepage: https://hub.kelee.one
# icon: https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Spotify.png
# date: 2026-06-01 17:11:35
# lpx: https://kelee.one/Tool/Loon/Lpx/Spotify_remove_ads.lpx
# converted: Loon .lpx -> Stash .stoverride (auto) v2
# note: kelee.one resources require Loon UA; if Stash fetch fails, add proxy or use GitHub mirror
name: Spotify去广告
desc: 移除播放广告，恢复歌手和专辑列表的正常展示。修改插件自定义配置项需要重新登陆方可生效。
icon: https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Spotify.png
rules:
- AND,((DOMAIN-SUFFIX,spotify.com),(PROTOCOL,QUIC)),REJECT
script-providers:
  spotify-remove-ads-1:
    url: https://stash.ponyo.fun/scripts/spotify-remove-ads.js
    interval: 86400
http:
  mitm:
  - '*-spclient.spotify.com'
  - spclient.wg.spotify.com
  url-rewrite:
  - ^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/pendragon\/ - reject-dict
  - ^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/artistview\/v1\/artist\/(.*)&platform=iphone - 302 https://spclient.wg.spotify.com/artistview/v1/artist/$1&platform=ipad
  script:
  - match: ^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:bootstrap|user-customization-service)
    name: spotify-remove-ads-1
    type: response
    require-body: true
    binary-body-mode: true
    timeout: 5
    argument: '[false,true]'
