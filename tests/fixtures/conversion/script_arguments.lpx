#!name=Script Arguments Contract
#!desc=Per-script $argument encoding, enable defaults and option mapping
#!author=conversion-verifier

[Argument]
tab=switch, false, true, tag=移除底栏创建按钮, desc=此开关控制是否移除底栏创建按钮
useractivity=switch, true, false, tag=启用Apple设备接力, desc=此开关控制是否使用Apple设备接力
displayUpList=select, "show", "hide", "auto", tag=[动态]中[最常访问]的显示方式
purifyComment=switch, true, false, tag=移除评论区置顶广告
optimizeRequest=switch, true, false, tag=优化评论区加载异常
sponsorBlock=switch, false, true, tag=空降助手
logLevel=select, "off", "error", "warn", tag=日志等级
sampleRate=input, 0.5, type=number, tag=采样率
Weather.Provider=select, "ColorfulClouds", "WeatherKit", "QWeather"
NextHour.Provider=select, "ColorfulClouds", "WeatherKit", "QWeather"
AirQuality.Calculate.Algorithm=select, "EU_EAQI", "None", "UBA"
API.ColorfulClouds.Token=input, ""
API.QWeather.Host=input, "devapi.qweather.com"
API.QWeather.Token=input, ""
API.WAQI.Token=input, ""
Storage=select, "Argument", "PersistentStore", "database"
LogLevel=select, "WARN", "OFF", "ERROR"

[Script]
response if ${url} ~= /^https:\/\/spclient\.example\.com\/spotify-bootstrap\?/i then script("https://kelee.one/Resource/JavaScript/Spotify/Spotify_remove_ads.js", {${tab}, ${useractivity}}) with tag="Spotify", timeout=5, requires_body=true, binary_body_mode=true
response if ${url} ~= /^https:\/\/spclient\.example\.com\/bili-response\?/i then script("https://kelee.one/Resource/JavaScript/Bilibili/Bilibili_proto_response_kokoryh.js", {${displayUpList}, ${purifyComment}, ${sponsorBlock}, ${logLevel}}) with tag="Bilibili", requires_body=true, binary_body_mode=true
request if ${url} ~= /^https:\/\/spclient\.example\.com\/bili-request-enabled\?/i then script("https://kelee.one/Resource/JavaScript/Bilibili/Bilibili_proto_request_kokoryh.js", {${purifyComment}, ${logLevel}}) with enable=${optimizeRequest}, tag="enabled", timeout=7, requires_body=true, binary_body_mode=true
request if ${url} ~= /^https:\/\/spclient\.example\.com\/bili-request-disabled\?/i then script("https://kelee.one/Resource/JavaScript/Bilibili/Bilibili_proto_request_kokoryh.js", {${logLevel}}) with enable=${sponsorBlock}, tag="disabled"
response if ${url} ~= /^https:\/\/weatherkit\.example\.com\/api\/v2\/weather\//i then script("https://github.com/NSRingo/WeatherKit/releases/download/v3.1.0/response.bundle.js", {${Weather.Provider}, ${NextHour.Provider}, ${AirQuality.Calculate.Algorithm}, ${API.ColorfulClouds.Token}, ${API.QWeather.Host}, ${API.QWeather.Token}, ${API.WAQI.Token}, ${Storage}, ${LogLevel}}) with tag="WeatherKit", requires_body=true, binary_body_mode=true
response if ${url} ~= /^https:\/\/spclient\.example\.com\/numeric\?/i then script("https://kelee.one/Resource/JavaScript/Spotify/Spotify_remove_ads.js", {${sampleRate}}) with tag="Numeric"
response if ${url} ~= /^https:\/\/spclient\.example\.com\/ignored\?/i then script("https://kelee.one/Resource/JavaScript/Bilibili/Bilibili_json_kokoryh.js", {${sampleRate}}) with tag="Ignored"

[MitM]
hostname=spclient.example.com, weatherkit.example.com
