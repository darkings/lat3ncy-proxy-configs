#!name=演示托管脚本
#!desc=构建测试用最小 Loon 插件：托管脚本 provider + 共享远程 jq。
#!author=fixture
#!icon=https://example.test/icon-script.png
#!homepage=https://example.test/home
#!date=2026-02-03 04:05:06

[Rule]
DOMAIN,script-ads.example.test,REJECT

[Script]
http-response ^https:\/\/api\.example\.test\/script script-path=https://kelee.one/Resource/JavaScript/Demo/clean.js, requires-body=true, binary-body-mode=false, tag=DemoClean

[Rewrite]
response if ${url} ~= /^https:\/\/api\.example\.test\/feed$/i then response.json.jq_file("https://kelee.one/Resource/JQLang/Demo/clean.jq")

[MitM]
hostname=api.example.test, media.example.test
